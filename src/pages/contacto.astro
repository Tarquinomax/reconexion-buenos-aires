---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Disclaimer from '../components/Disclaimer.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { BUSINESS } from '../consts';

const path = '/contacto';
const title = 'Contacto, modalidades y reservas en Buenos Aires';
const description =
  'Modalidades presenciales en Buenos Aires y sesiones a distancia. Cómo reservar, horarios de atención, medios de contacto y qué información recibís antes de la sesión.';

const breadcrumbs = [
  { name: 'Inicio', item: '/' },
  { name: 'Contacto', item: path },
];

const whatsappHref = `https://wa.me/${BUSINESS.whatsapp}?text=${encodeURIComponent(
  'Hola, me gustaría consultar por una sesión.',
)}`;

const modalidades = [
  {
    marker: 'A',
    tone: 'terracota' as const,
    title: 'Presencial en Buenos Aires',
    text: 'Consultorio en la Ciudad Autónoma de Buenos Aires. La dirección exacta se comparte al confirmar la reserva. Placeholder: indicar accesibilidad, transporte cercano y valor de la sesión.',
  },
  {
    marker: 'B',
    tone: 'salvia' as const,
    title: 'A distancia',
    text: 'Para el resto de Argentina y el exterior. Necesitás un espacio tranquilo donde puedas recostarte sin interrupciones durante una hora. Placeholder: indicar valor y medios de pago.',
  },
];

const dias: Record<string, string> = {
  Monday: 'Lunes',
  Tuesday: 'Martes',
  Wednesday: 'Miércoles',
  Thursday: 'Jueves',
  Friday: 'Viernes',
  Saturday: 'Sábado',
  Sunday: 'Domingo',
};

const horarios = BUSINESS.openingHours.map((block) => ({
  label:
    block.days.length > 1
      ? `${dias[block.days[0]!]} a ${dias[block.days[block.days.length - 1]!]}`
      : dias[block.days[0]!]!,
  range: `${block.opens} – ${block.closes}`,
}));
---

<BaseLayout title={title} description={description} canonicalPath={path} breadcrumbs={breadcrumbs}>
  <PageHeader
    eyebrow="Reservas"
    title="Contacto y modalidades"
    lead="Antes de reservar podemos conversar sin compromiso. Prefiero una consulta previa honesta a una sesión con expectativas mal encuadradas."
    breadcrumbs={breadcrumbs}
  />

  <Section>
    <div class="grid gap-5 md:grid-cols-2">
      {
        modalidades.map((m) => (
          <FeatureCard title={m.title} marker={m.marker} tone={m.tone}>
            {m.text}
          </FeatureCard>
        ))
      }
    </div>
  </Section>

  <Section tone="muted">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <h2 class="text-3xl md:text-4xl">Cómo reservar</h2>
        <ol class="mt-8 space-y-6">
          <li class="flex gap-4">
            <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-terracota-100 text-sm text-terracota-800">1</span>
            <p class="leading-relaxed text-stone-600">
              Escribime por WhatsApp o correo electrónico contándome brevemente qué te trae. No hace
              falta ningún detalle clínico.
            </p>
          </li>
          <li class="flex gap-4">
            <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-terracota-100 text-sm text-terracota-800">2</span>
            <p class="leading-relaxed text-stone-600">
              Respondo con las fechas disponibles, el valor y el encuadre completo por escrito.
            </p>
          </li>
          <li class="flex gap-4">
            <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-terracota-100 text-sm text-terracota-800">3</span>
            <p class="leading-relaxed text-stone-600">
              Confirmada la fecha, recibís la dirección exacta o el enlace de coordinación según la modalidad.
            </p>
          </li>
        </ol>

        <div class="mt-10 flex flex-wrap gap-3">
          <Button href={whatsappHref} size="lg" external>Escribir por WhatsApp</Button>
          <Button href={`mailto:${BUSINESS.email}`} variant="secondary" size="lg">Enviar un correo</Button>
        </div>

        <p class="mt-6 text-sm text-stone-500">
          Los datos que compartas se tratan según la
          <a class="underline underline-offset-4 hover:text-terracota-700" href="/legal/privacidad">Política de Privacidad</a>.
          No se utilizan para envíos comerciales sin tu consentimiento.
        </p>
      </div>

      <aside class="lg:col-span-5">
        <div class="rounded-organic border border-stone-200 bg-stone-50 p-6 md:p-8">
          <h2 class="font-display text-xl">Datos de contacto</h2>

          <address class="mt-5 space-y-4 text-sm not-italic">
            <div>
              <p class="text-xs tracking-[0.14em] text-stone-500 uppercase">Ubicación</p>
              <p class="mt-1 text-stone-800">{BUSINESS.address.streetAddress}</p>
              <p class="text-stone-800">
                {BUSINESS.address.addressLocality} ({BUSINESS.address.postalCode})
              </p>
            </div>

            <div>
              <p class="text-xs tracking-[0.14em] text-stone-500 uppercase">Teléfono</p>
              <a class="mt-1 block text-stone-800 underline decoration-stone-300 underline-offset-4 hover:text-terracota-700" href={`tel:${BUSINESS.phone}`}>
                {BUSINESS.phoneDisplay}
              </a>
            </div>

            <div>
              <p class="text-xs tracking-[0.14em] text-stone-500 uppercase">Correo</p>
              <a class="mt-1 block text-stone-800 underline decoration-stone-300 underline-offset-4 hover:text-terracota-700" href={`mailto:${BUSINESS.email}`}>
                {BUSINESS.email}
              </a>
            </div>
          </address>

          <div class="mt-6 border-t border-stone-200 pt-5">
            <p class="text-xs tracking-[0.14em] text-stone-500 uppercase">Horarios de atención</p>
            <dl class="mt-3 space-y-2 text-sm">
              {
                horarios.map((h) => (
                  <div class="flex justify-between gap-4">
                    <dt class="text-stone-600">{h.label}</dt>
                    <dd class="text-stone-800">{h.range}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="mt-3 text-xs text-stone-500">Horario de Argentina (GMT-3).</p>
          </div>

          <div class="mt-6 border-t border-stone-200 pt-5">
            <p class="text-xs tracking-[0.14em] text-stone-500 uppercase">Zonas de atención</p>
            <p class="mt-2 text-sm text-stone-600">{BUSINESS.areaServed.join(' · ')}</p>
          </div>
        </div>

        <!--
          TODO(cliente): si se incorpora un mapa, cargarlo solo tras el consentimiento
          de cookies (evento `rba:consent`). Un iframe de Google Maps cargado por
          defecto transfiere datos a terceros sin base legal y rompe la CSP.
        -->
      </aside>
    </div>
  </Section>

  <Section width="prose">
    <Disclaimer />
  </Section>
</BaseLayout>
