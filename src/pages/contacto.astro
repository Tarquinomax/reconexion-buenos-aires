---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Disclaimer from '../components/Disclaimer.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { BUSINESS, DIAS_SEMANA, SITE } from '../consts';

const path = '/contacto';
const mainEntityId = `${SITE.url}/sanacion-reconectiva#channel-remoto`;
const title = 'Reserva tus sesiones';
const description =
  'Coordiná tu sesión de Sanación Reconectiva® a distancia o La Reconexión® presencial en CABA. WhatsApp y correo.';

const breadcrumbs = [
  { name: 'Inicio', item: '/' },
  { name: 'Reserva', item: path },
];

const whatsappHref = `https://wa.me/${BUSINESS.whatsapp}?text=${encodeURIComponent(
  'Hola José, quisiera consultar por una sesión',
)}`;

const modalidades = [
  {
    marker: 'A',
    tone: 'salvia' as const,
    title: 'Sanación Reconectiva®',
    text: 'Modalidad: exclusivamente a distancia. Duración: 40 minutos. Alcance: cualquier lugar del mundo y también mascotas. Frecuencia sugerida: de 1 a 3 sesiones según la evolución y el sentir del consultante.',
  },
  {
    marker: 'B',
    tone: 'terracota' as const,
    title: 'La Reconexión®',
    text: 'Modalidad: exclusivamente presencial. Ubicación: CABA (Zona Recoleta) — dirección exacta al coordinar el turno. Estructura: 2 sesiones consecutivas (días seguidos o con 1 día intermedio). Se realiza una única vez en la vida.',
  },
];

const horarios = BUSINESS.openingHours.map((block) => ({
  label:
    block.days.length > 1
      ? `${DIAS_SEMANA[block.days[0]!]} a ${DIAS_SEMANA[block.days[block.days.length - 1]!]}`
      : DIAS_SEMANA[block.days[0]!]!,
  range: `${block.opens} – ${block.closes}`,
}));
---

<BaseLayout title={title} description={description} canonicalPath={path} breadcrumbs={breadcrumbs} mainEntityId={mainEntityId}>
  <PageHeader
    eyebrow="Reservas"
    title="Reserva tus sesiones"
    lead="Dar el paso hacia una sesión es una decisión consciente de reconexión y bienestar integral. Ya sea que busques restaurar tu equilibrio físico, mental o emocional, o iniciar un salto en el propósito de tu vida, aquí encontrarás la información clara para coordinar tu turno de manera directa y personalizada."
    breadcrumbs={breadcrumbs}
  />

  <Section>
    <div class="grid gap-5 md:grid-cols-2">
      {
        modalidades.map((m) => (
          <FeatureCard title={m.title} marker={m.marker} tone={m.tone}>
            {m.text}
          </FeatureCard>
        ))
      }
    </div>
  </Section>

  <Section tone="muted">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <h2 class="text-3xl md:text-4xl">¿Cómo es el proceso para reservar tu sesión?</h2>
        <ol class="mt-8 space-y-6">
          <li class="flex gap-4">
            <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-terracota-100 text-sm text-terracota-800">1</span>
            <p class="leading-relaxed text-stone-600">
              <strong>Contacto inicial:</strong> Enviame un mensaje por WhatsApp o correo detallando si tu interés es
              Sanación Reconectiva (a distancia) o La Reconexión (presencial).
            </p>
          </li>
          <li class="flex gap-4">
            <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-terracota-100 text-sm text-terracota-800">2</span>
            <p class="leading-relaxed text-stone-600">
              <strong>Coordinación de agenda:</strong> Definimos juntos día y horario acordes a tu huso horario y
              disponibilidad.
            </p>
          </li>
          <li class="flex gap-4">
            <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-terracota-100 text-sm text-terracota-800">3</span>
            <p class="leading-relaxed text-stone-600">
              <strong>Confirmación y pautas:</strong> Recibirás las indicaciones sencillas para tu sesión (un espacio
              tranquilo donde recostarte o la confirmación de recepción en el consultorio presencial de CABA).
            </p>
          </li>
        </ol>

        <div class="mt-10">
          <h3 class="font-display text-xl">Canal directo de reserva y consultas</h3>
          <p class="mt-3 leading-relaxed text-stone-600">
            El medio más rápido y directo es WhatsApp. Por favor, enviá mensaje escrito en lugar de llamadas. Durante las
            sesiones el teléfono permanece en silencio para resguardar la concentración y la privacidad de los consultantes.
          </p>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={whatsappHref} size="lg" external>
            Escribir por WhatsApp al {BUSINESS.phoneDisplay}
          </Button>
          <Button href={`mailto:${BUSINESS.email}`} variant="secondary" size="lg">
            Correo: {BUSINESS.email}
          </Button>
        </div>

        <p class="mt-6 text-sm text-stone-500">
          Los datos que compartas se tratan según la
          <a class="underline underline-offset-4 hover:text-terracota-700" href="/legal/privacidad">Política de Privacidad</a>.
        </p>
      </div>

      <aside class="lg:col-span-5">
        <div class="rounded-organic border border-stone-200 bg-stone-50 p-6 md:p-8">
          <h2 class="font-display text-xl">Datos de contacto</h2>

          <address class="mt-5 space-y-4 text-sm not-italic">
            <div>
              <p class="text-xs tracking-[0.14em] text-stone-500 uppercase">Ubicación (La Reconexión)</p>
              <p class="mt-1 text-stone-800">CABA · Zona Recoleta</p>
              <p class="text-stone-600">Dirección exacta al coordinar el turno</p>
            </div>

            <div>
              <p class="text-xs tracking-[0.14em] text-stone-500 uppercase">WhatsApp oficial</p>
              <a
                class="mt-1 block text-stone-800 underline decoration-stone-300 underline-offset-4 hover:text-terracota-700"
                href={whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
              >
                {BUSINESS.phoneDisplay}
              </a>
            </div>

            <div>
              <p class="text-xs tracking-[0.14em] text-stone-500 uppercase">Correo seguro</p>
              <a
                class="mt-1 block text-stone-800 underline decoration-stone-300 underline-offset-4 hover:text-terracota-700"
                href={`mailto:${BUSINESS.email}`}
              >
                {BUSINESS.email}
              </a>
            </div>
          </address>

          <div class="mt-6 border-t border-stone-200 pt-5">
            <p class="text-xs tracking-[0.14em] text-stone-500 uppercase">Horarios de atención</p>
            <dl class="mt-3 space-y-2 text-sm">
              {
                horarios.map((h) => (
                  <div class="flex justify-between gap-4">
                    <dt class="text-stone-600">{h.label}</dt>
                    <dd class="text-stone-800">{h.range}</dd>
                  </div>
                ))
              }
              <div class="flex justify-between gap-4">
                <dt class="text-stone-600">Sábados</dt>
                <dd class="text-stone-800">Consultar disponibilidad</dd>
              </div>
            </dl>
            <p class="mt-3 text-xs text-stone-500">Horario de Argentina (GMT-3). Días hábiles.</p>
          </div>

          <div class="mt-6 border-t border-stone-200 pt-5">
            <p class="text-xs tracking-[0.14em] text-stone-500 uppercase">Modalidades</p>
            <ul class="mt-2 space-y-1 text-sm text-stone-600">
              <li>Sanación Reconectiva®: exclusivamente a distancia (40 min)</li>
              <li>La Reconexión®: exclusivamente presencial en CABA</li>
              <li>Mascotas: sesiones a distancia</li>
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </Section>

  <Section width="prose">
    <Disclaimer />
  </Section>
</BaseLayout>
