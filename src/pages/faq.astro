---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import FaqItem from '../components/FaqItem.astro';
import Disclaimer from '../components/Disclaimer.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Button from '../components/Button.astro';
import { BUSINESS, SITE } from '../consts';
import { faqNode, type FaqEntry } from '../lib/schema';

const path = '/faq';
const url = new URL(path, SITE.url).href;

const title = 'Preguntas';
const description =
  'Preguntas frecuentes sobre Sanación Reconectiva® y La Reconexión®: qué son, diferencias, sesiones a distancia, preparación, beneficios y valor de La Reconexión.';

const faqUpdated = '2026-10-25';

const breadcrumbs = [
  { name: 'Inicio', item: '/' },
  { name: 'Preguntas', item: path },
];

const faqs: Array<FaqEntry & { id: string }> = [
  {
    id: 'q01',
    question: '¿Qué es la Sanación Reconectiva®?',
    answer:
      'La Sanación Reconectiva® es una forma de sanación que se encuentra presente en nuestro planeta por primera vez (manifestada a partir del año 1985 con el Dr. Eric Pearl). Nos reconecta de manera directa con la plenitud del universo y, simultáneamente, con la plenitud del Ser que somos. No se trata de una terapia tradicional ni de un conjunto de técnicas energéticas aisladas; es el acceso a un nuevo y amplio espectro de sanación compuesto por frecuencias de energía, luz e información. La existencia y los efectos tangibles de este ancho de banda han sido demostrados tanto en la práctica cotidiana con miles de personas alrededor del mundo como en rigurosas investigaciones científicas y de laboratorio internacional.',
  },
  {
    id: 'q02',
    question: '¿Qué es La Reconexión®?',
    answer:
      'La Reconexión® es el proceso integral de reconexión con el universo que profundiza y expande el trabajo iniciado con la Sanación Reconectiva®. Estas frecuencias evolutivas forman parte de la Nueva Energía y nos llegan a través de un espectro continuo de luz e información. Gracias a La Reconexión®, el ser humano es capaz de interactuar conscientemente con estos nuevos niveles de frecuencia, reactivando los filamentos del ADN y restaurando el puente de comunicación entre el macrocosmos y el microcosmos. Es un paso evolutivo definitivo que se realiza una sola vez en la vida.',
  },
  {
    id: 'q03',
    question: '¿Qué diferencia hay entre la Sanación Reconectiva® y La Reconexión®?',
    answer:
      'La diferencia radica fundamentalmente en el propósito y la intención con la que se facilita cada proceso. La Sanación Reconectiva® tiene por objetivo restaurar el equilibrio integral de la persona, ya sea en el plano físico, mental, emocional o espiritual. La Reconexión® está orientada a la reconexión inherente con el universo. Se realiza a través de un protocolo exacto de dos sesiones individuales presenciales. Ejemplo: la Sanación Reconectiva® equivale a ordenar los programas de una computadora; La Reconexión® equivale a conectarla a Internet por primera vez.',
  },
  {
    id: 'q04',
    question: '¿Cómo sana el cuerpo con la Sanación Reconectiva®?',
    answer:
      'No seguimos el modelo mecánico o químico aprendido convencionalmente en las escuelas; el cuerpo humano responde de manera profunda a frecuencias e intercambios de información. Como demostró la biofísica contemporánea a través de las investigaciones sobre biofotones (Dr. Fritz-Albert Popp), cada una de las células emite y absorbe luz en frecuencias específicas. La Sanación Reconectiva® introduce al campo biológico un espectro puro de energía, luz e información que permite que el propio cuerpo reconozca su estado natural de orden y reactive sus mecanismos innatos de autorregulación.',
  },
  {
    id: 'q05',
    question: '¿Sobre qué síntomas o dolencias actúa la Sanación Reconectiva®?',
    answer:
      '«Se sana la persona, no la enfermedad», como enseña el Dr. Eric Pearl. La Sanación Reconectiva® no está dirigida a tratar síntomas específicos, dolencias puntuales ni patologías de forma aislada. Restablece la coherencia y el equilibrio integral del Ser en todos sus planos: físico, mental, emocional y espiritual. Dos personas con el mismo diagnóstico médico pueden experimentar transformaciones completamente distintas.',
  },
  {
    id: 'q06',
    question: '¿Qué base científica sustenta la Sanación Reconectiva® y La Reconexión®?',
    answer:
      'Ambos procesos encuentran un marco explicativo claro en los conceptos de la física cuántica contemporánea y la teoría de cuerdas. La materia, en su nivel fundamental, es energía e información vibrando en un campo unificado. La física cuántica ha demostrado el principio de no-localidad. La Sanación Reconectiva® opera en ese nivel de campo informativo, facilitando un colapso del estado cuántico hacia el orden y la armonía.',
  },
  {
    id: 'q07',
    question: 'La experiencia durante la sesión, ¿qué indica?',
    answer:
      'Durante las sesiones se puede o no experimentar sensaciones desde lo sensorial (cambios de temperatura, hormigueos, movimientos musculares involuntarios o registros), pero eso no indica ni determina en absoluto el grado ni la profundidad de los beneficios. Hay personas que durante la sesión «no sintieron nada» y, sin embargo, a partir de ese momento comienzan a notar cambios notorios y profundos en su vida cotidiana.',
  },
  {
    id: 'q08',
    question: '¿Cómo son las sesiones de Sanación Reconectiva® a distancia y cómo se preparan?',
    answer:
      'En mi práctica profesional, la Sanación Reconectiva® se facilita de manera exclusiva a distancia, con exactamente la misma efectividad que una sesión presencial. Se coordina previamente un día y horario. Pautas: vestir ropa cómoda; quitarse el calzado; evitar perfumes o fragancias intensas; recostarse boca arriba, cerrar los ojos y descansar en silencio durante 40 minutos. Al concluir, nos comunicamos de forma inmediata por WhatsApp o llamada.',
  },
  {
    id: 'q09',
    question: '¿Cómo son las sesiones para La Reconexión®?',
    answer:
      'La Reconexión® se facilita exclusivamente de manera presencial en la Ciudad Autónoma de Buenos Aires (CABA). Dos sesiones individuales, con intervalo mínimo de 24 horas y máximo de 72 horas. La persona se recuesta sobre una camilla boca arriba, con ropa cómoda y los ojos cerrados. Sin contacto físico. Se realiza una única vez en la vida.',
  },
  {
    id: 'q10',
    question: '¿Cuánto dura una sesión y cómo se comprende el tiempo en este proceso?',
    answer:
      'En una sesión de Sanación Reconectiva® a distancia, el tiempo operativo es de 40 minutos. Estas frecuencias pertenecen al dominio cuántico, donde rige la no-localidad: el estímulo de coherencia ocurre instantáneamente y continúa desplegándose e integrándose a lo largo de las semanas siguientes. La Reconexión® no posee una duración fija predeterminada en minutos; varía según cada persona.',
  },
  {
    id: 'q11',
    question: '¿Qué actitud es recomendable tener durante la sesión?',
    answer:
      'La mejor actitud interior es la entrega neutra y sin expectativas fijas. No es necesario meditar de forma forzada, concentrarse en un síntoma, visualizar colores ni repetir afirmaciones mentales. El Dr. Eric Pearl: «Si eres afortunado, tu sanación vendrá en la forma que habías anticipado. Si eres verdaderamente afortunado, tu sanación vendrá de una forma que ni siquiera habías soñado, aquella que el Universo ha reservado especialmente para ti».',
  },
  {
    id: 'q12',
    question: '¿Qué beneficios se pueden esperar con La Reconexión®?',
    answer:
      'Con La Reconexión® se reactiva y acelera el proceso evolutivo individual. Al reconectar los meridianos axiatonales y los filamentos energéticos del ADN, la persona experimenta una integración profunda con su propósito vital. Muchos consultantes reportan mayor intuición, disolución de patrones de estancamiento, nuevas oportunidades y sensación de arraigo y sincronía.',
  },
  {
    id: 'q13',
    question: '¿Qué beneficios se pueden obtener con una sesión de Sanación Reconectiva®?',
    answer:
      '«Se sana la persona, no la enfermedad». Entre los beneficios observados con mayor frecuencia: desaparición o disminución de molestias y dolores físicos, restablecimiento del sueño, liberación de estrés y angustia, y claridad mental. La energía recibida ayuda a disolver memorias energéticas discordantes.',
  },
  {
    id: 'q14',
    question: '¿Cómo se compara esto con otras frecuencias y formas de trabajo con la energía?',
    answer:
      'Las técnicas energéticas tradicionales (Qi Gong, Sanación Pránica, imposición de manos) cumplieron y cumplen un rol de valor; sin embargo, muchas están sujetas a rituales, símbolos e invocaciones. La Sanación Reconectiva® trasciende la necesidad de rituales, amuletos o escudos de protección, trabajando con un espectro holístico e inagotable de Energía, Luz e Información.',
  },
  {
    id: 'q15',
    question: '¿Entonces esta disciplina es mejor que otras técnicas?',
    answer:
      'No se plantea bajo la premisa de superioridad, sino de amplitud y evolución del espectro. Una técnica energética concreta suele operar con un puñado de letras del abecedario; la Sanación Reconectiva® otorga acceso al alfabeto completo.',
  },
  {
    id: 'q16',
    question: 'Diferencias entre Reiki y Sanación Reconectiva®: ¿Cómo se aplican y cómo operan?',
    answer:
      'En el Reiki: disciplina estructurada con sintonizaciones por niveles; manos sobre o cerca de puntos específicos; símbolos; protocolos de cierre. En la Sanación Reconectiva®: no es canalización ni depende de niveles; no se toca el cuerpo; manos libres y dinámicas en el campo energético; sin protecciones ni limpiezas posteriores; el facilitador también recibe sanación mientras facilita.',
  },
  {
    id: 'q17',
    question: '¿Cuántas sesiones son necesarias?',
    answer:
      'No se realizan tratamientos. Se sugiere experimentar entre 1 y 3 sesiones de Sanación Reconectiva®. Cada sesión es completa en sí misma. La persona decide libremente. Para La Reconexión®: estrictamente 2 únicas sesiones en la vida.',
  },
  {
    id: 'q18',
    question: '¿Las mascotas son receptivas a las sesiones de Sanación Reconectiva®?',
    answer:
      'Sí, las mascotas son extraordinariamente receptivas. Al no poseer dudas intelectuales ni expectativas, conectan de forma pura e inmediata. Las sesiones se facilitan exclusivamente a distancia, en su entorno habitual.',
  },
  {
    id: 'q19',
    question: '¿Se pueden facilitar sesiones en niños, mujeres embarazadas o personas internadas?',
    answer:
      'Sí, en todos los casos. Es completamente segura y no presenta contraindicaciones ni efectos secundarios. Los niños responden con rapidez. En embarazadas favorece el bienestar de madre y bebé. A distancia puede brindarse a personas hospitalizadas sin interferir en su entorno médico.',
  },
  {
    id: 'q20',
    question: '¿Por qué La Reconexión® tiene un valor de intercambio fijado internacionalmente en 333?',
    answer:
      'El valor 333 responde a un estándar ético y universal establecido por el Dr. Eric Pearl en su libro Sana a otros, sánate a ti mismo y regulado globalmente por The Reconnection. Corresponde al intercambio que el propio Dr. Pearl abonó al recibir su Reconexión personal. Previene la especulación comercial: ningún facilitador puede elevar ni abaratar el costo. Se establece en 333 dólares, euros o el equivalente oficial en moneda local según el país.',
  },
];

const schema = [
  faqNode(
    faqs.map(({ question, answer, id }) => ({
      question,
      answer,
      id,
      dateModified: faqUpdated,
    })),
    url,
  ),
];

const whatsappHref = `https://wa.me/${BUSINESS.whatsapp}?text=${encodeURIComponent(
  'Hola José, quisiera hacerte una consulta',
)}`;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={path}
  breadcrumbs={breadcrumbs}
  schema={schema}
  mainEntityId={`${url}#faq`}
>
  <PageHeader
    eyebrow="Antes de reservar"
    title="Preguntas"
    lead="Respuestas sobre Sanación Reconectiva® y La Reconexión®. Si tu duda no aparece acá, escribime y la respondo sin compromiso."
    breadcrumbs={breadcrumbs}
  />

  <Section width="prose">
    <div class="mt-2">
      {
        faqs.map((faq, index) => (
          <FaqItem question={faq.question} open={index === 0}>
            <p>{faq.answer}</p>
          </FaqItem>
        ))
      }
    </div>

    <div class="not-prose mt-10">
      <Button href={whatsappHref} size="lg" external>
        Consultar por WhatsApp
      </Button>
    </div>

    <p class="mt-8 text-sm text-stone-600">
      Facilitado por José A. | Facilitador Certificado de Sanación Reconectiva® (Nivel I y II) y La Reconexión® (Nivel
      III) formado oficialmente en 2012 por el Dr. Eric Pearl y The Reconnection. Más de 1.100 sesiones facilitadas en
      Argentina y a nivel internacional.
    </p>

    <Disclaimer class="mt-10" />
  </Section>

  <CtaBanner title="¿Te quedó una duda sin responder?" />
</BaseLayout>
