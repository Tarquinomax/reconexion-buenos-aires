---
import { NAV_PRIMARY, SITE } from '../consts';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<header
  class="sticky top-0 z-50 border-b border-stone-200/70 bg-stone-50/85 backdrop-blur-md supports-[backdrop-filter]:bg-stone-50/70"
>
  <div class="container-page flex h-16 items-center justify-between gap-6 md:h-20">
    <a
      href="/"
      class="group flex items-center gap-2.5 text-stone-900 transition-opacity hover:opacity-80"
      aria-label={`${SITE.name} — Inicio`}
    >
      <span
        class="inline-flex size-9 items-center justify-center rounded-full bg-terracota-100 text-terracota-700 transition-transform duration-500 ease-[var(--ease-organic)] group-hover:rotate-45"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" fill="none" class="size-5" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="3.25"></circle>
          <path d="M12 2.5v4M12 17.5v4M2.5 12h4M17.5 12h4" stroke-linecap="round"></path>
          <path d="M5.4 5.4l2.8 2.8M15.8 15.8l2.8 2.8M18.6 5.4l-2.8 2.8M8.2 15.8l-2.8 2.8" stroke-linecap="round" opacity="0.55"></path>
        </svg>
      </span>
      <span class="font-display text-lg leading-tight tracking-tight md:text-xl">
        Reconexión <span class="text-terracota-700">Buenos Aires</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navegación principal">
      {
        NAV_PRIMARY.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-full px-3.5 py-2 text-sm transition-colors duration-300',
              isActive(item.href)
                ? 'bg-terracota-100/70 font-medium text-terracota-800'
                : 'text-stone-600 hover:bg-stone-200/60 hover:text-stone-900',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/contacto"
        class="hidden rounded-full bg-stone-900 px-5 py-2.5 text-sm font-medium text-stone-50 transition-all duration-300 ease-[var(--ease-organic)] hover:-translate-y-0.5 hover:bg-terracota-700 sm:inline-block"
      >
        Reservar sesión
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="inline-flex size-10 items-center justify-center rounded-full text-stone-700 transition-colors hover:bg-stone-200/70 lg:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú de navegación"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-6" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú móvil: se renderiza en el HTML y solo alterna el atributo hidden. -->
  <div
    id="menu-movil"
    hidden
    class="border-t border-stone-200/70 bg-stone-50/95 backdrop-blur-md lg:hidden"
  >
    <nav class="container-page flex flex-col gap-1 py-4" aria-label="Navegación principal móvil">
      {
        NAV_PRIMARY.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-2xl px-4 py-3 transition-colors',
              isActive(item.href) ? 'bg-terracota-100/70 text-terracota-800' : 'hover:bg-stone-200/60',
            ]}
          >
            <span class="block text-base font-medium text-stone-900">{item.label}</span>
            {item.hint && <span class="block text-sm text-stone-500">{item.hint}</span>}
          </a>
        ))
      }
      <a
        href="/contacto"
        class="mt-2 rounded-full bg-stone-900 px-5 py-3 text-center text-base font-medium text-stone-50"
      >
        Reservar sesión
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-movil');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
    };

    toggle.addEventListener('click', () => {
      setOpen(menu.hidden);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Cierra el menú al pasar a viewport de escritorio y evita estados inconsistentes.
    const desktop = window.matchMedia('(min-width: 1024px)');
    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
