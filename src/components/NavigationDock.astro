---
import { NAV_PRIMARY, SITE } from '../consts';

/** Dock inferior SOLO en móvil. Desktop usa el header. */
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);

type IconName =
  | 'persona'
  | 'reconexion'
  | 'sanacion'
  | 'entrevistas'
  | 'testimonios'
  | 'preguntas'
  | 'reserva'
  | 'mascotas'
  | 'blog';

const ICONS: Record<string, string> = {
  persona:
    '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.9 3.1-6.5 7-6.5s7 2.6 7 6.5"/>',
  reconexion:
    '<circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="12" r="2.5"/><path d="M8.5 12h7"/><path d="M12 4.5v3M12 16.5v3"/>',
  sanacion:
    '<path d="M12 20s-7-4.4-7-9.5A4 4 0 0 1 12 8a4 4 0 0 1 7 2.5C19 15.6 12 20 12 20z"/>',
  entrevistas:
    '<rect x="3" y="6" width="13" height="12" rx="2"/><path d="M16 10l5-3v10l-5-3z"/>',
  testimonios: '<path d="M4 5h16v11H9l-5 4V5z"/>',
  preguntas:
    '<circle cx="12" cy="12" r="8.5"/><path d="M9.8 9.5a2.3 2.3 0 1 1 3 2.2c-.8.4-1 .9-.9 1.8"/><circle cx="12" cy="16.8" r=".4" fill="currentColor"/>',
  reserva:
    '<rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/><path d="M9.5 15h5"/>',
  mascotas:
    '<circle cx="7" cy="9" r="1.6"/><circle cx="12" cy="7" r="1.6"/><circle cx="17" cy="9" r="1.6"/><path d="M12 12c-3 0-5 2.2-5 4.2 0 1.6 1.4 2.3 2.8 1.9 1.4-.4 3-.4 4.4 0 1.4.4 2.8-.3 2.8-1.9 0-2-2-4.2-5-4.2z"/>',
  blog: '<path d="M5 5h14v14H5z"/><path d="M8 9h8M8 12h8M8 15h5"/>',
};

const DOCK_ITEMS: { href: string; label: string; short: string; icon: IconName }[] = [
  { href: '/sobre-mi', label: 'Quién soy', short: 'Quién soy', icon: 'persona' },
  { href: '/la-reconexion', label: 'La Reconexión', short: 'Reconexión', icon: 'reconexion' },
  { href: '/sanacion-reconectiva', label: 'Sanación Reconectiva', short: 'Sanación', icon: 'sanacion' },
  { href: '/entrevistas', label: 'Entrevistas', short: 'Entrevistas', icon: 'entrevistas' },
  { href: '/testimonios', label: 'Testimonios', short: 'Testimonios', icon: 'testimonios' },
  { href: '/faq', label: 'Preguntas', short: 'Preguntas', icon: 'preguntas' },
  { href: '/contacto', label: 'Reserva', short: 'Reservar', icon: 'reserva' },
  { href: '/mascotas', label: 'Mascotas', short: 'Mascotas', icon: 'mascotas' },
];

const navHrefs = new Set([...NAV_PRIMARY.map((n) => n.href), '/contacto']);
for (const item of DOCK_ITEMS) {
  if (!navHrefs.has(item.href)) {
    throw new Error(`NavigationDock: ruta "${item.href}" no declarada en la SSOT`);
  }
}
---

<nav
  aria-label="Navegación principal (móvil)"
  class="pointer-events-none fixed inset-x-0 bottom-0 z-50 flex justify-center px-3 pb-[max(0.85rem,env(safe-area-inset-bottom))] md:hidden"
>
  <div class="pointer-events-auto relative w-full max-w-lg">
    <div
      class="pointer-events-none absolute inset-y-0 left-0 z-10 w-8 rounded-l-full bg-gradient-to-r from-bosque-900/90 to-transparent"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute inset-y-0 right-0 z-10 w-8 rounded-r-full bg-gradient-to-l from-bosque-900/90 to-transparent"
      aria-hidden="true"
    ></div>
    <ul
      class="flex w-full items-stretch gap-0.5 overflow-x-auto scroll-smooth rounded-full border border-bronce-500/25 bg-bosque-900/90 p-1.5 shadow-elevated backdrop-blur-xl [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      {
        DOCK_ITEMS.map((item) => (
          <li class="shrink-0">
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              title={item.label}
              class:list={[
                'flex min-w-[4.25rem] flex-col items-center gap-0.5 rounded-full px-2.5 py-2 text-[10px] font-medium leading-tight transition-all duration-300 ease-[var(--ease-organic)] active:scale-95',
                isActive(item.href)
                  ? 'bg-cream text-bosque-900 shadow-sm'
                  : 'text-cream/80 hover:bg-white/10 hover:text-cream',
              ]}
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-4 shrink-0"
                aria-hidden="true"
                set:html={ICONS[item.icon]}
              />
              <span class="whitespace-nowrap">{item.short}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<meta name="theme-color" content={SITE.themeColor} />
