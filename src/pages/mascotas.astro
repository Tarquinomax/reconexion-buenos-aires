---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Disclaimer from '../components/Disclaimer.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { SITE } from '../consts';
import { petServiceNode } from '../lib/schema';

const path = '/mascotas';
const url = new URL(path, SITE.url).href;

const title = 'Sanación para mascotas';
const description =
  'Sesiones a distancia de Sanación Reconectiva para perros y gatos. Sostén complementario, no veterinario: ante cualquier síntoma, consultá a un médico veterinario matriculado.';

const breadcrumbs = [
  { name: 'Inicio', item: '/' },
  { name: 'Sanación para mascotas', item: path },
];

// Nodo #service del grafo (definido en src/lib/schema.ts). La pagina lo
// referencia por @id mediante mainEntity: jerarquia piramidal bidireccional
// WebPage -> Service -> #channel-remoto, resuelta estaticamente en el build.
const serviceNode = petServiceNode();
const mainEntityId = `${url}#service`;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={path}
  breadcrumbs={breadcrumbs}
  schema={[serviceNode]}
  mainEntityId={mainEntityId}
>
  <PageHeader
    eyebrow="Sesiones a distancia"
    title="Sanación para mascotas"
    lead="Perros y gatos también pueden recibir las sesiones de Sanación Reconectiva de forma remota, sin el estrés del traslado. Esta solapa presenta el encuadre del servicio y dos casos reales documentados: Reina (gata, 17 años) y Scubby (perro, 3 años)."
    breadcrumbs={breadcrumbs}
  />

  {/* Ficha del servicio (design system "Architectural Serenity"). Datos leidos
      de la SSOT cuando existe; los tiempos se describen en funcion del
      encuadre estandar de una sesion individual. */}
  <Section>
    <div class="grid gap-5 sm:grid-cols-3" data-reveal>
      <div class="rounded-organic border border-cream-200 bg-cream-100 p-6 text-center">
        <p class="text-xs font-semibold uppercase tracking-wider text-stone-500">Modalidad</p>
        <p class="mt-2 font-display text-xl text-stone-900">100% a distancia</p>
        <p class="mt-1 text-sm text-stone-600">En el hogar de la mascota</p>
      </div>
      <div class="rounded-organic border border-cream-200 bg-cream-100 p-6 text-center">
        <p class="text-xs font-semibold uppercase tracking-wider text-stone-500">Duración</p>
        <p class="mt-2 font-display text-xl text-stone-900">Hasta 45 min</p>
        <p class="mt-1 text-sm text-stone-600">Mismo encuadre que una sesión individual</p>
      </div>
      <div class="rounded-organic border border-cream-200 bg-cream-100 p-6 text-center">
        <p class="text-xs font-semibold uppercase tracking-wider text-stone-500">Envío previo</p>
        <p class="mt-2 font-display text-xl text-stone-900">Foto y datos</p>
        <p class="mt-1 text-sm text-stone-600">Nombre de la mascota y motivo de consulta</p>
      </div>
    </div>
    <p class="mt-6 max-w-2xl text-sm leading-relaxed text-stone-500">
     PLACEHOLDER(cliente): confirmar la duración específica de las sesiones para mascotas antes de
      publicar. Este sitio no publica cifras de tiempo no verificadas.
    </p>
  </Section>

  {/* Layout de documento estandar (scroll fluido, orientado a SEO): el
      contenedor ya NO fija 100dvh ni recorta con overflow-hidden.
      Navegacion interna de pestanas con CSS puro: inputs radio ocultos +
      selectores checked: de Tailwind v4. Cero JavaScript en el cliente; todo
      se resuelve estaticamente durante el build. El Caso Reina es la pestana
      visible por defecto (checked en origen, sin JS). */}
  <div class="flex flex-col">

    {/* Selector de pestanas (radio nativo, accesible por teclado) */}
    <input
      type="radio"
      name="caso-mascotas"
      id="tab-reina"
      class="peer/reina sr-only"
      checked
    />
    <input
      type="radio"
      name="caso-mascotas"
      id="tab-scubby"
      class="peer/scubby sr-only"
    />

    <nav aria-label="Casos reales" class="flex shrink-0 gap-2 border-b border-stone-200 px-1 pt-2">
      <label
        for="tab-reina"
        class="cursor-pointer rounded-t-organic px-4 py-2 text-sm font-medium text-stone-500 transition-colors peer-checked/reina:bg-cream peer-checked/reina:text-stone-900 hover:text-stone-800"
      >
        Caso Reina (gata)
      </label>
      <label
        for="tab-scubby"
        class="cursor-pointer rounded-t-organic px-4 py-2 text-sm font-medium text-stone-500 transition-colors peer-checked/scubby:bg-cream peer-checked/scubby:text-stone-900 hover:text-stone-800"
      >
        Caso Scubby (perro)
      </label>
    </nav>

    {/* PESTANA 1 — Caso Real de Reina (visible al cargar: radio checked) */}
    <Section class="hidden grow peer-checked/reina:flex peer-checked/reina:flex-col">
      <div class="grid h-full gap-8 md:grid-cols-2 md:items-start">
        <figure class="order-2 self-center md:order-1">
          {/* Foto original de Reina, sin filtros ni ediciones de IA. */}
          <img
            src="/images/reina.webp"
            alt="Reina, gata de 17 años, antes y despues de las sesiones de Sanacion Reconectiva a distancia"
            width="640"
            height="480"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full rounded-organic border border-stone-200 object-cover"
          />
          <figcaption class="mt-2 text-xs uppercase tracking-wide text-stone-500">
            Reina · fotografía original, sin ediciones.
          </figcaption>
        </figure>
        <div class="order-1 md:order-2">
          <h2 class="font-display text-2xl leading-snug">Caso Real de Reina</h2>
          <p class="mt-1 text-xs uppercase tracking-wide text-stone-500">
            Gata · 17 años · sesión a distancia · 15 de octubre de 2014
          </p>
          {/* Relato literal de Maria M., tomado de la web original (2012). */}
          <p class="mt-3 text-stone-600 leading-relaxed">
            «Mi gata Reina tiene 17 años. Hace unas semanas empezó a vomitar y el
            veterinario diagnosticó que sus riñones y su hígado estaban muy
            deteriorados; nos preparábamos para lo peor. Recibió una sesión de
            Sanación Reconectiva a distancia el 15 de octubre de 2014 y el cambio
            fue súbito: al día siguiente volvió a pedir comida con las ganas de
            siempre, recuperó toda su energía y dejó de vomitar. Hoy Reina vuelve a
            ser la gata viva y presente que conocemos.»
          </p>
          <p class="mt-3 text-sm text-stone-500">— María M., tutora de Reina</p>
          <p class="mt-4 text-xs text-stone-500">
            Relato personal de la tutora. No sustituye el diagnóstico ni el
            tratamiento veterinario. Enlaces semánticos:
            <a href={mainEntityId} class="underline">servicio</a> ·
            <a href={`${url}#caso-reina`} class="underline">nodo del caso</a>.
          </p>
        </div>
      </div>
    </Section>

    {/* PESTANA 2 — Caso Real de Scubby + modal nativo del informe de laboratorio */}
    <Section class="hidden grow peer-checked/scubby:flex peer-checked/scubby:flex-col">
      <div class="grid h-full gap-8 md:grid-cols-2 md:items-start">
        <figure class="order-2 self-center md:order-1">
          {/* Foto original de Scubby, sin filtros ni ediciones de IA. */}
          <img
            src="/images/scubby.webp"
            alt="Scubby, perro de 3 anos, retrato original aportado por su tutora Lorena T."
            width="640"
            height="480"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full rounded-organic border border-stone-200 object-cover"
          />
          <figcaption class="mt-2 text-xs uppercase tracking-wide text-stone-500">
            Scubby · fotografía original, sin ediciones.
          </figcaption>
        </figure>
        <div class="order-1 md:order-2">
          <h2 class="font-display text-2xl leading-snug">Caso Real de Scubby</h2>
          <p class="mt-1 text-xs uppercase tracking-wide text-stone-500">
            Perro · 3 años · cuadro crítico · informe de laboratorio 11/ago/2015
          </p>
          <div class="mt-3 space-y-3 text-stone-600 leading-relaxed">
            <p>
              «Lorena vive en La Plata y su cachorro Scubby, de tres años, se
              estaba muriendo. Los análisis indicaban un hematocrito del 4%, con
              valores normales entre 37 y 55. El veterinario nos dijo que había
              que hacerle una transfusión de sangre urgente, pero no teníamos
              tiempo: era domingo por la noche y Scubby podía no pasarla.»
            </p>
            <p>
              «Le pedí a otra dueña que me acompañara en la sanación para
              Scubby. Mientras tanto, el veterinario le hacía la transfusión. Al
              día siguiente, cuando vimos los resultados, él mismo compartió el
              estudio con sus colegas, sorprendido por la evolución del cuadro.»
            </p>
          </div>
          <p class="mt-3 text-sm text-stone-500">— Lorena T., tutora de Scubby (La Plata)</p>
          {/* Trigger nativo del modal: <dialog> abierto con command="show-modal"
              (attribute-based invocations, HTML estatico, cero JS en el hilo
              principal). Cierre declarativo via <form method="dialog">. */}
          <button
            type="button"
            class="mt-4 inline-flex items-center gap-2 rounded-full bg-terracota-700 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-terracota-800"
            commandfor="informe-laboratorio"
            command="show-modal"
          >
            Ver informe de laboratorio
          </button>
        </div>
      </div>
    </Section>

    {/* Modal nativo declarativo: attribute-based invocations (HTML estatico,
        sin script en el hilo principal). Backward-compatible: si el navegador
        no soporta command/show-modal, el dialogo permanece cerrado sin romper
        el layout Single-Viewport. */}
    <dialog
      id="informe-laboratorio"
      class="fixed inset-0 m-auto h-fit w-full max-w-lg rounded-organic border border-stone-200 bg-white p-6 shadow-elevated backdrop:bg-stone-900/40"
    >
      <h3 class="font-display text-xl leading-snug">Informe de laboratorio — Scubby (Protocolo N° 305353)</h3>
      <img
        src="/images/laboratorio-scubby.webp"
        alt="Informe de laboratorio de Scubby del 11 de agosto de 2015, documento original escaneado"
        width="640"
        height="480"
        loading="lazy"
        decoding="async"
        class="mt-4 w-full rounded-organic border border-stone-200 object-contain"
      />
      <table class="mt-4 w-full text-left text-sm">
        <caption class="sr-only">Matriz de valores del informe del 11/ago/2015</caption>
        <thead>
          <tr class="border-b border-stone-200 text-xs uppercase tracking-wide text-stone-500">
            <th scope="col" class="py-2 pr-4">Parámetro</th>
            <th scope="col" class="py-2 pr-4">Resultado</th>
            <th scope="col" class="py-2">Referencia</th>
          </tr>
        </thead>
        <tbody class="text-stone-700">
          <tr class="border-b border-stone-100"><td class="py-2 pr-4">Hematocrito</td><td class="py-2 pr-4 font-semibold text-terracota-800">4,3% (Manual: 3%)</td><td class="py-2">37 – 55 %</td></tr>
          <tr class="border-b border-stone-100"><td class="py-2 pr-4">Hemoglobina</td><td class="py-2 pr-4 font-semibold text-terracota-800">2,6 g/dl</td><td class="py-2">12 a 18 g/dl</td></tr>
          <tr class="border-b border-stone-100"><td class="py-2 pr-4">Recuento G. Rojos</td><td class="py-2 pr-4 font-semibold text-terracota-800">0,8 millones/µl</td><td class="py-2">5,5 a 8,5 millones/µl</td></tr>
          <tr><td class="py-2 pr-4">Leucocitos</td><td class="py-2 pr-4 font-semibold text-terracota-800">25.300 /µl</td><td class="py-2">6.000 a 18.000 /µl</td></tr>
        </tbody>
      </table>
      <form method="dialog" class="mt-4 text-right">
        <button type="submit" class="rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100">
          Cerrar
        </button>
      </form>
    </dialog>
  </div>

  <Disclaimer />
  <CtaBanner />
</BaseLayout>
