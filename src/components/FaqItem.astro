---
export interface Props {
  question: string;
  open?: boolean;
}

const { question, open = false } = Astro.props;
---

<details
  open={open}
  class="group border-b border-bosque-900/10 py-5 transition-colors duration-300 [&[open]_.faq-icon]:rotate-45 [&[open]_.faq-icon]:bg-bronce-100 [&[open]_.faq-icon]:text-bronce-700"
>
  <summary
    class="flex cursor-pointer list-none items-start justify-between gap-6 text-left text-lg text-bosque-900 transition-colors duration-300 hover:text-bronce-700 [&::-webkit-details-marker]:hidden"
  >
    <span class="font-display leading-snug">{question}</span>
    <span
      class="faq-icon mt-1 inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-bosque-900/8 text-bosque-700 transition-all duration-300 ease-[var(--ease-organic)]"
      aria-hidden="true"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4">
        <path d="M12 5v14M5 12h14" stroke-linecap="round"></path>
      </svg>
    </span>
  </summary>
  <div class="mt-4 max-w-2xl animate-[fade-in_0.35s_var(--ease-organic)] text-[0.97rem] leading-relaxed text-bosque-800/80">
    <slot />
  </div>
</details>
