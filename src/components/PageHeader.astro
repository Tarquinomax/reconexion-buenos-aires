---
import Breadcrumbs from './Breadcrumbs.astro';
import type { BreadcrumbEntry } from '../lib/schema';

export interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  breadcrumbs?: BreadcrumbEntry[];
}

const { eyebrow, title, lead, breadcrumbs = [] } = Astro.props;
---

<header class="bg-aura border-b border-stone-200/70">
  <div class="container-page pt-8 pb-10 md:pt-10 md:pb-14">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mt-6 max-w-3xl animate-fade-up">
      {
        eyebrow && (
          <p class="text-xs font-semibold tracking-[0.18em] text-terracota-700 uppercase">{eyebrow}</p>
        )
      }
      <h1 class="mt-3 text-4xl leading-[1.1] md:text-5xl lg:text-6xl">{title}</h1>
      {lead && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-stone-600 md:text-xl">{lead}</p>}
      <slot />
    </div>
  </div>
</header>
