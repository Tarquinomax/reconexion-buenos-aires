---
import { NAV_PRIMARY, SITE } from '../consts';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<header
  class="sticky top-0 z-50 border-b border-bosque-900/8 bg-cream/90 backdrop-blur-xl supports-[backdrop-filter]:bg-cream/75"
>
  <div class="container-page flex h-16 items-center justify-between gap-4 md:h-[4.5rem]">
    <a
      href="/"
      class="group flex min-w-0 items-center gap-2.5 text-bosque-900 transition-opacity duration-300 hover:opacity-80"
      aria-label={`${SITE.name} — Inicio`}
    >
      <span
        class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-bronce-100 text-bronce-700 transition-transform duration-500 ease-[var(--ease-organic)] group-hover:rotate-45"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" fill="none" class="size-5" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="3.25"></circle>
          <path d="M12 2.5v4M12 17.5v4M2.5 12h4M17.5 12h4" stroke-linecap="round"></path>
          <path d="M5.4 5.4l2.8 2.8M15.8 15.8l2.8 2.8M18.6 5.4l-2.8 2.8M8.2 15.8l-2.8 2.8" stroke-linecap="round" opacity="0.55"></path>
        </svg>
      </span>
      <span class="font-display text-lg leading-tight tracking-tight md:text-xl">
        Reconexión <span class="text-bronce-600">Buenos Aires</span>
      </span>
    </a>

    <nav class="hidden items-center gap-0.5 xl:flex" aria-label="Navegación principal">
      {
        NAV_PRIMARY.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'relative rounded-full px-3 py-2 text-[13px] transition-all duration-300 ease-[var(--ease-organic)]',
              isActive(item.href)
                ? 'bg-bosque-900/6 font-medium text-bosque-900'
                : 'text-bosque-700/75 hover:bg-bosque-900/5 hover:text-bosque-900',
            ]}
          >
            {item.label}
            {
              isActive(item.href) && (
                <span
                  class="absolute inset-x-3 -bottom-px h-0.5 rounded-full bg-bronce-500"
                  aria-hidden="true"
                />
              )
            }
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/contacto"
        class="hidden rounded-full bg-bosque-900 px-5 py-2.5 text-sm font-medium text-cream shadow-sm transition-all duration-300 ease-[var(--ease-organic)] hover:-translate-y-0.5 hover:bg-bronce-600 hover:shadow-md sm:inline-flex"
      >
        Reservar sesión
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="inline-flex size-10 items-center justify-center rounded-full text-bosque-800 transition-colors duration-300 hover:bg-bosque-900/8 xl:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú de navegación"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-6" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="menu-movil"
    hidden
    class="border-t border-bosque-900/8 bg-cream/95 backdrop-blur-xl xl:hidden"
  >
    <nav class="container-page flex flex-col gap-1 py-4" aria-label="Navegación principal móvil">
      {
        NAV_PRIMARY.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-2xl px-4 py-3 transition-all duration-300 ease-[var(--ease-organic)]',
              isActive(item.href)
                ? 'bg-bosque-900/6 text-bosque-900'
                : 'hover:bg-bosque-900/5',
            ]}
          >
            <span class="block text-base font-medium text-bosque-900">{item.label}</span>
            {item.hint && <span class="block text-sm text-bosque-700/60">{item.hint}</span>}
          </a>
        ))
      }
      <a
        href="/contacto"
        class="mt-2 rounded-full bg-bosque-900 px-5 py-3 text-center text-base font-medium text-cream transition-colors duration-300 hover:bg-bronce-600"
      >
        Reservar sesión
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-movil');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
    };

    toggle.addEventListener('click', () => {
      setOpen(menu.hidden);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    const desktop = window.matchMedia('(min-width: 1280px)');
    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
