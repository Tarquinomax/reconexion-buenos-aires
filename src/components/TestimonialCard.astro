---
export interface Props {
  /** Nombre o iniciales. Se publica solo con autorización explícita. */
  author: string;
  /** Contexto que evita la lectura como promesa de resultado. */
  context: string;
  /** Modalidad: presencial u online. */
  modality?: string;
  date?: string;
}

const { author, context, modality, date } = Astro.props;
---

<figure class="flex h-full flex-col rounded-organic border border-stone-200 bg-stone-50 p-6 md:p-8">
  <span class="font-display text-4xl leading-none text-terracota-300" aria-hidden="true">&ldquo;</span>
  <blockquote class="mt-3 grow text-[0.97rem] leading-relaxed text-stone-700">
    <slot />
  </blockquote>
  <figcaption class="mt-6 border-t border-stone-200 pt-4 text-sm">
    <span class="block font-medium text-stone-900">{author}</span>
    <span class="mt-1 block text-stone-500">
      {context}
      {modality && <> · {modality}</>}
      {date && <> · {date}</>}
    </span>
  </figcaption>
</figure>
