---
export interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg' | 'link';
  class?: string;
  external?: boolean;
  'aria-label'?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  class: className = '',
  external = false,
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-medium transition-all duration-300 ease-[var(--ease-organic)] hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]';

const variants = {
  primary:
    'bg-bosque-900 text-cream shadow-sm hover:bg-bronce-600 hover:shadow-md',
  secondary:
    'border border-bosque-900/15 bg-cream text-bosque-900 hover:border-bronce-500/50 hover:text-bronce-700',
  ghost: 'text-bosque-800 hover:text-bronce-700',
} as const;

const sizes = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3.5 text-base',
  link: 'py-1 text-sm',
} as const;

const classes = [base, variants[variant], sizes[size], className];
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{
  href ? (
    <a href={href} class:list={classes} {...externalAttrs} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
