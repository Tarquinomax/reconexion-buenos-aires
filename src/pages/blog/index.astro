---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { SITE } from '../../consts';
import { ID } from '../../lib/schema';

const path = '/blog';
const url = new URL(path, SITE.url).href;

const title = 'Blog: artículos y recursos';
const description =
  'Artículos sobre Sanación Reconectiva y La Reconexión escritos con criterio: sin promesas, sin pseudociencia y con los límites del trabajo siempre explícitos.';

const breadcrumbs = [
  { name: 'Inicio', item: '/' },
  { name: 'Blog', item: path },
];

const posts = (await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const dateFormatter = new Intl.DateTimeFormat('es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

/** CollectionPage + ItemList: le da a los buscadores la estructura del listado. */
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${url}#collection`,
    url,
    name: title,
    description,
    isPartOf: { '@id': ID.website },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: posts.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: new URL(`/blog/${post.id}`, SITE.url).href,
        name: post.data.title,
      })),
    },
  },
];
---

<BaseLayout title={title} description={description} canonicalPath={path} breadcrumbs={breadcrumbs} schema={schema}>
  <PageHeader
    eyebrow="Recursos"
    title="Artículos y recursos"
    lead="Textos para entender el trabajo antes de decidir. Cada artículo indica su fecha de publicación y su última revisión."
    breadcrumbs={breadcrumbs}
  />

  <Section>
    {
      posts.length === 0 ? (
        <p class="text-stone-600">
          Todavía no hay artículos publicados. Los primeros textos se publican en las próximas semanas.
        </p>
      ) : (
        <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}`}
                class="group flex h-full flex-col rounded-organic border border-stone-200 bg-stone-50 p-6 transition-all duration-500 ease-[var(--ease-organic)] hover:-translate-y-1 hover:border-terracota-200 hover:shadow-[0_20px_50px_-28px_rgb(68_64_60/0.4)] md:p-8"
              >
                <div class="flex flex-wrap items-center gap-2 text-xs text-stone-500">
                  <time datetime={post.data.publishedAt.toISOString()}>
                    {dateFormatter.format(post.data.publishedAt)}
                  </time>
                  {post.data.readingTime && <span aria-hidden="true">·</span>}
                  {post.data.readingTime && <span>{post.data.readingTime} min de lectura</span>}
                </div>

                <h2 class="mt-4 text-xl leading-snug md:text-2xl">{post.data.title}</h2>
                <p class="mt-3 grow text-[0.95rem] leading-relaxed text-stone-600">{post.data.description}</p>

                {post.data.tags.length > 0 && (
                  <ul class="mt-6 flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => (
                      <li class="rounded-full bg-stone-200/70 px-3 py-1 text-xs text-stone-600">{tag}</li>
                    ))}
                  </ul>
                )}

                <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-terracota-700">
                  Leer artículo
                  <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
                    →
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </Section>

  <CtaBanner title="¿Preferís conversarlo en persona?" />
</BaseLayout>
