---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { NAV_PRIMARY } from '../consts';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscás no existe o cambió de dirección."
  noindex
>
  <section class="bg-aura flex min-h-[70vh] items-center">
    <div class="container-page py-24 text-center">
      <p class="font-display text-6xl text-terracota-300 md:text-8xl">404</p>
      <h1 class="mt-6 text-3xl md:text-5xl">Esta página no existe</h1>
      <p class="mx-auto mt-5 max-w-md leading-relaxed text-stone-600">
        Puede que el enlace haya cambiado. Te dejo los accesos principales del sitio.
      </p>

      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <Button href="/" size="lg">Volver al inicio</Button>
        <Button href="/contacto" variant="secondary" size="lg">Ir a contacto</Button>
      </div>

      <ul class="mx-auto mt-12 flex max-w-2xl flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
        {
          NAV_PRIMARY.map((item) => (
            <li>
              <a class="text-stone-600 underline decoration-stone-300 underline-offset-4 hover:text-terracota-700" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
