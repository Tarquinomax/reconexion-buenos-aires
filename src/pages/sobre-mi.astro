---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Disclaimer from '../components/Disclaimer.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { PRACTITIONER, BUSINESS, SITE } from '../consts';
import { ID, videoNode } from '../lib/schema';

const path = '/sobre-mi';
const title = 'José A. | Facilitador Certificado de Sanación Reconectiva y La Reconexión';
const description =
  'Facilitador Certificado de Sanación Reconectiva (Nivel I y II) y de La Reconexión (Nivel III), formado en septiembre de 2012 en Buenos Aires por el Dr. Eric Pearl y The Reconnection. +10 años y +1.100 sesiones.';

const breadcrumbs = [
  { name: 'Inicio', item: '/' },
  { name: 'Sobre mí', item: path },
];

/** URL embebible del video (CSP permite youtube-nocookie.com). */
const videoId = 'TWVJc_DTp9o';

/** Nodo VideoObject para el grafo JSON-LD de esta página (E-E-A-T: creator = Person). */
const testimonialVideo = videoNode({
  id: `${SITE.url}/#video-testimonio-personal`,
  name: 'Mi testimonio en video — José A.',
  description:
    'Testimonio personal de José A., Facilitador Certificado de Sanación Reconectiva y La Reconexión, sobre cómo la llegada de estas frecuencias transformó su camino.',
  thumbnailUrl: `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`,
  uploadDate: '2024-01-01T00:00:00Z', // PLACEHOLDER(cliente): fecha real de publicación del video
  duration: 'PT5M', // PLACEHOLDER(cliente): duración real del video
  embedUrl: `https://www.youtube-nocookie.com/embed/${videoId}`,
  contentUrl: PRACTITIONER.videoTestimonialUrl,
});

/** Hitos verificables: son la base de la señal E-E-A-T y del nodo Person del JSON-LD. */
const hitos = [
  {
    year: '2012',
    title: 'Formación Oficial Directa',
    text: `Certificación oficial otorgada por The Reconnection y el Dr. Eric Pearl en Buenos Aires (${PRACTITIONER.masteryLabel}).`,
  },
  {
    year: `${String(2026 - PRACTITIONER.yearsOfPractice)} — hoy`,
    title: 'Experiencia Comprobada',
    text: `Más de ${PRACTITIONER.sessionsDelivered.toLocaleString('es-AR')} sesiones facilitadas a consultantes de Argentina, Europa y diversos países de Latinoamérica.`,
  },
];

/** Métricas clave (SSOT: PRACTITIONER en src/consts.ts). */
const metricas = [
  { label: 'Experiencia', value: `${PRACTITIONER.yearsOfPractice} años`, hint: 'Práctica ininterrumpida' },
  { label: 'Casuística', value: `+${PRACTITIONER.sessionsDelivered.toLocaleString('es-AR')}`, hint: 'Sesiones facilitadas' },
  { label: 'Acreditación', value: PRACTITIONER.certificationLevel.split('—')[0]!.trim(), hint: 'The Reconnection LLC' },
];
---

<BaseLayout
  title={title}
  description={description}
  rawTitle
  canonicalPath={path}
  breadcrumbs={breadcrumbs}
  schema={[testimonialVideo]}
  mainEntityId={ID.person}
>
  <PageHeader
    eyebrow="Quién acompaña"
    title={PRACTITIONER.name}
    lead={PRACTITIONER.jobTitle}
    breadcrumbs={breadcrumbs}
  >
    {/* Insignias de acreditación (design system "Architectural Serenity"). */}
    <div class="mt-6 flex flex-wrap items-center gap-2">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-sand-200/70 px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-forest-800">
        ✓ {PRACTITIONER.certificationLevel.split('—')[0]!.trim()}
      </span>
      <span class="inline-flex items-center gap-1.5 rounded-full border border-cream-200 bg-cream-100 px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-stone-600">
        Recoleta · CABA
      </span>
    </div>
  </PageHeader>

  <Section>
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <div
          class="aspect-4/5 w-full overflow-hidden rounded-[2.5rem] border border-cream-200 bg-gradient-to-br from-cream-100 via-sand-100 to-cream-200"
        >
          <!-- TODO(cliente): reemplazar por <Image /> de astro:assets con la fotografía profesional. -->
          <div class="flex h-full items-end p-8">
            <p class="font-display text-lg text-stone-600">Fotografía profesional</p>
          </div>
        </div>

        <dl class="mt-8 space-y-4 text-sm">
          <div class="flex justify-between gap-4 border-b border-stone-200 pb-3">
            <dt class="text-stone-500">Certificación</dt>
            <dd class="text-right text-stone-800">{PRACTITIONER.masteryLabel} · The Reconnection</dd>
          </div>
          <div class="flex justify-between gap-4 border-b border-stone-200 pb-3">
            <dt class="text-stone-500">Ubicación</dt>
            <dd class="text-right text-stone-800">{BUSINESS.address.streetAddress}, {BUSINESS.address.addressLocality}</dd>
          </div>
          <div class="flex justify-between gap-4 border-b border-stone-200 pb-3">
            <dt class="text-stone-500">Modalidades</dt>
            <dd class="text-right text-stone-800">Presencial y a distancia</dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-7">
        <div class="prose prose-stone max-w-none prose-headings:font-display prose-headings:font-normal prose-a:text-terracota-700">
          <h2>Mi propósito</h2>
          <p>
            Mi propósito es facilitar el acceso directo a un espectro amplio de frecuencias de energía,
            luz e información orientadas a restablecer el equilibrio integral en los niveles físico,
            mental, emocional y espiritual.
          </p>

          <h2>Quién soy</h2>
          <p>
            Soy José A., Facilitador Certificado de Sanación Reconectiva ({PRACTITIONER.levelsDetail.sanacion})
            y de La Reconexión ({PRACTITIONER.levelsDetail.reconexion}), formado oficialmente en
            {PRACTITIONER.masteryLabel} en Buenos Aires por el Dr. Eric Pearl y el equipo docente de
            The Reconnection.
          </p>
          <p>
            A lo largo de más de una década de práctica continua, he facilitado procesos individuales a
            más de {PRACTITIONER.sessionsDelivered.toLocaleString('es-AR')} personas de Argentina, Europa
            y diversos países de Latinoamérica, acompañándolas en su restablecimiento energético y
            evolución personal.
          </p>

          <h2>Modalidades de atención definidas</h2>
          <ul>
            <li>
              <strong>Sanación Reconectiva®:</strong> sesiones facilitadas exclusivamente a distancia, con
              idéntico alcance sin importar el lugar geográfico donde te encuentres.
            </li>
            <li>
              <strong>La Reconexión®:</strong> proceso facilitado exclusivamente en modalidad presencial en
              la Ciudad Autónoma de Buenos Aires (CABA).
            </li>
          </ul>

          <h2>Enfoque ético e individual</h2>
          <p>
            Mi dedicación profesional está enfocada exclusivamente en la atención personalizada de cada
            consultante (no dicto cursos ni seminarios masivos). No emito diagnósticos, no interfiero con
            tratamientos médicos y derivo cuando el pedido excede este trabajo.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="muted">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold tracking-[0.18em] text-forest-800 uppercase">Métricas clave</p>
      <h2 class="mt-3 text-3xl md:text-4xl">Trayectoria en números</h2>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-3">
      {
        metricas.map((m) => (
          <div class="rounded-organic border border-cream-200 bg-cream-100 p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-stone-500">{m.label}</p>
            <p class="mt-2 font-display text-3xl text-stone-900">{m.value}</p>
            <p class="mt-1 text-sm text-stone-600">{m.hint}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section>
    <div class="max-w-2xl">
      <p class="text-xs font-semibold tracking-[0.18em] text-terracota-700 uppercase">Trayectoria</p>
      <h2 class="mt-3 text-3xl md:text-4xl">Formación y práctica</h2>
    </div>

    <ol class="mt-12 space-y-px overflow-hidden rounded-organic border border-stone-200 bg-stone-200">
      {
        hitos.map((hito) => (
          <li class="grid gap-3 bg-stone-50 p-6 md:grid-cols-12 md:gap-8 md:p-8">
            <span class="font-display text-lg text-terracota-700 md:col-span-3">{hito.year}</span>
            <div class="md:col-span-9">
              <h3 class="text-xl">{hito.title}</h3>
              <p class="mt-2 leading-relaxed text-stone-600">{hito.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section tone="muted">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold tracking-[0.18em] text-forest-800 uppercase">Video</p>
      <h2 class="mt-3 text-3xl md:text-4xl">Mi testimonio en video</h2>
      <p class="mt-4 leading-relaxed text-stone-600">
        Comparto mi experiencia personal y cómo la llegada de estas frecuencias transformó mi camino.
      </p>
    </div>

    <div class="mt-10 overflow-hidden rounded-organic border border-cream-200 bg-stone-900">
      <div class="aspect-video w-full">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${videoId}`}
          title="Mi testimonio en video — José A., Facilitador Certificado"
          class="h-full w-full"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        />
      </div>
    </div>
    <p class="mt-3 text-sm text-stone-500">
      También disponible en YouTube:&nbsp;
      <a
        href={PRACTITIONER.videoTestimonialUrl}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="text-forest-800 underline decoration-cream-300 underline-offset-4 hover:decoration-forest-800"
      >
        Ver el video original
      </a>
    </p>
  </Section>

  <Section width="prose">
    <Disclaimer />
  </Section>

  <CtaBanner
    title="Consulta y Reserva de Sesiones"
    text={`Si sentís que es el momento de restablecer tu equilibrio o iniciar tu proceso, podés comunicarte directamente. Horarios de atención: lunes a viernes de 09:00 a 16:00 hs (días hábiles).`}
  />
</BaseLayout>
