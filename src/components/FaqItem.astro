---
export interface Props {
  question: string;
  /** Abre el primer elemento para dar contexto inmediato sin JS. */
  open?: boolean;
}

const { question, open = false } = Astro.props;
---

<details
  open={open}
  class="group border-b border-stone-200 py-5 [&[open]_.faq-icon]:rotate-45"
>
  <summary
    class="flex cursor-pointer list-none items-start justify-between gap-6 text-left text-lg text-stone-900 transition-colors hover:text-terracota-800 [&::-webkit-details-marker]:hidden"
  >
    <span class="font-display">{question}</span>
    <span
      class="faq-icon mt-1 inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-stone-200/80 text-stone-600 transition-transform duration-300 ease-[var(--ease-organic)]"
      aria-hidden="true"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4">
        <path d="M12 5v14M5 12h14" stroke-linecap="round"></path>
      </svg>
    </span>
  </summary>
  <div class="mt-4 max-w-2xl text-[0.97rem] leading-relaxed text-stone-600">
    <slot />
  </div>
</details>
